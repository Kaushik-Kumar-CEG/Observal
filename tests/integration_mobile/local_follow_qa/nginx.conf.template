# Local-only TLS issuer. Host networking is required for loopback-only listener and upstreams.
events {}
http {
    include /etc/nginx/mime.types;
    access_log off; # do not log browser/device challenge codes
    server {
        listen 127.0.0.1:18443 ssl;
        server_name localhost;
        ssl_certificate /qa/leaf.crt;
        ssl_certificate_key /qa/leaf.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Cache-Control "no-store" always;
        location /api/v1/ {
            proxy_pass http://follow_api;
            proxy_set_header Host $host:$server_port;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host:$server_port;
            proxy_set_header Origin $http_origin;
            proxy_hide_header Access-Control-Allow-Origin;
        }
        location = /readyz {
            proxy_pass http://follow_api;
        }
        location / {
            root /web;
            try_files $uri /index.html;
        }
    }
    upstream follow_api {
        server 127.0.0.1:__API_A__;
        server 127.0.0.1:__API_B__;
    }
}
